APP_NAME=sAdmin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://sadmin.localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sadmin_dev
DB_USERNAME=sadmin
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

# WebAuthn (ADR 0002): RP ID sebenarnya = institutions.console_hostname
SADMIN_RP_ID=sadmin.localhost
SADMIN_ORIGIN=

# Brankas (ADR 0003): nama kredensial systemd kunci induk. Dev: SADMIN_VAULT_DEV_KEY = path berkas 32 byte mode 0600.
SADMIN_VAULT_CRED=sadmin-vault-master
SADMIN_VAULT_DEV_KEY=

VITE_APP_NAME="${APP_NAME}"
